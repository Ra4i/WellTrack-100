# WellTrack 100 Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env with real secrets - only commit .env.example

# ── Database ──────────────────────────────
DATABASE_CONNECTION_STRING=Data Source=welltrack.db

# ── API Settings ──────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# ── CORS Settings ─────────────────────────
FRONTEND_URL_LOCAL=http://localhost:3000
FRONTEND_URL_LIVE_SERVER=http://localhost:5500

# ── Logging ────────────────────────────────
LOG_LEVEL=Information
ASPNETCORE_LOG_LEVEL_DEFAULT=Information
ASPNETCORE_LOG_LEVEL_ASPNETCORE=Warning

# ── Security (Change these in production) ──
JWT_SECRET=your-secret-key-here-change-in-production
JWT_ISSUER=welltrack-api
JWT_AUDIENCE=welltrack-frontend
JWT_EXPIRATION_MINUTES=60

# ── Frontend Settings ──────────────────────
FRONTEND_API_URL=http://localhost:5000/api
FRONTEND_ENVIRONMENT=development
