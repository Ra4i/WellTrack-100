<!DOCTYPE html>
<html lang="bg">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Вход · WellTrack 100</title>
  <link rel="stylesheet" href='@Url.Content("~/css/style.css")' />
</head>
<body data-page="login">

  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-logo">
        <div class="logo-mark">W</div>
        <span>WellTrack <em>100</em></span>
      </div>

      <h1 data-i18n="auth.loginTitle">Добре дошли</h1>
      <p class="subtitle" data-i18n="auth.loginDescription">Продължи 100-дневното си уелнес пътешествие.</p>

      <div id="alert" class="alert"></div>

      <form id="login-form">
        <div class="form-group">
          <label for="email" data-i18n="auth.email">Имейл</label>
          <input type="email" id="email" placeholder="you@example.com" data-i18n="auth.email" required />
        </div>
        <div class="form-group">
          <label for="password" data-i18n="auth.password">Парола</label>
          <input type="password" id="password" placeholder="••••••••" data-i18n="auth.password" required />
        </div>
        <button type="submit" class="btn-primary" data-i18n="auth.login">Вход</button>
      </form>

      <div class="auth-footer">
        <span data-i18n="auth.noAccount">Нямаш акаунт?</span>
        <a href="@Url.Action("Register", "Home")" data-i18n="nav.startChallenge">Започни предизвикателството →</a>
      </div>
      <div class="auth-footer" style="margin-top:0.5rem">
        <a href="@Url.Action("Index", "Home")" style="color:var(--text-muted);font-size:0.82rem"><span aria-hidden="true">←</span> <span data-i18n="common.back">Обратно</span></a>
      </div>
    </div>
  </div>

  <div id="toast-container" class="toast-container"></div>
  <script src='@Url.Content("~/js/i18n.js")'></script>
  <script src='@Url.Content("~/js/app.js")'></script>
  <script>
    // Ensure init runs even if DOMContentLoaded already fired
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLogin);
    } else {
      initLogin();
    }
  </script>
</body>
</html>