<!DOCTYPE html>
<html lang="bg">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Прогрес · WellTrack 100</title>
  <script>
    try { var s=JSON.parse(localStorage.getItem('wt_user_settings')||'{}'); if(s.theme==='light') document.documentElement.setAttribute('data-theme','light'); } catch(e){}
  </script>
  <link rel="stylesheet" href="~/css/style.css" />
  <link rel="stylesheet" href="~/css/navbar.css" /> 
  <script src="~/js/i18n.js"></script>
</head>
<body data-page="progress">

  <div class="app-layout">
    <aside class="sidebar">
      <div class="sidebar-logo">
        <div class="logo-mark">W</div>
        <div class="logo-text">WellTrack <small>100-дневно предизвикателство</small></div>
      </div>
      <span class="nav-section-label">Основно</span>
      <a class="nav-item" href="@Url.Action("Dashboard", "Home")"><span class="nav-icon">⚡</span> <span data-i18n="nav.dashboard">Табло</span></a>
      <a class="nav-item" href="@Url.Action("Levels", "Home")"><span class="nav-icon">🏆</span> <span data-i18n="nav.levels">Нива</span></a>
      <a class="nav-item active" href="@Url.Action("Progress", "Home")"><span class="nav-icon">📈</span> <span data-i18n="nav.progress">Прогрес</span></a>
      <a class="nav-item" href="@Url.Action("Journal", "Home")"><span class="nav-icon">📓</span> <span data-i18n="nav.journal">Журнал</span></a>
      <a class="nav-item" href="@Url.Action("Friends", "Home")"><span class="nav-icon">👥</span> <span data-i18n="nav.friends">Приятели</span></a>
      <a class="nav-item" href="@Url.Action("Messages", "Home")"><span class="nav-icon">💬</span> <span data-i18n="nav.messages">Съобщения</span></a>
      <a class="nav-item" href="@Url.Action("Settings", "Home")"><span class="nav-icon">⚙️</span> <span data-i18n="nav.settings">Настройки</span></a>
      <div class="sidebar-bottom">
        <div class="user-chip">
          <div class="user-avatar user-avatar-init">A</div>
          <span class="user-name user-display-name">Зареждане...</span>
          <a class="logout-btn" title="Изход" href="@Url.Action("Login", "Home")">⏏</a>
        </div>
      </div>
    </aside>

    <main class="main-content">
      <div class="page-header">
        <h1 data-i18n="nav.progress">Прогрес</h1>
        <p class="breadcrumb">WellTrack 100 · <span>Твоето възстановяване</span></p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;margin-bottom:2rem;">
        <div class="stat-card">
          <div class="stat-icon">📅</div>
          <div class="stat-label" data-i18n="progress.loggedDays">Записани дни</div>
          <div class="stat-value" id="prog-completed" style="color:var(--accent)">0</div>
          <div class="stat-target">от 100 дни</div>
        </div>
        <div class="stat-card workout">
          <div class="stat-icon">🔥</div>
          <div class="stat-label" data-i18n="progress.currentStreak">Текуща серия</div>
          <div class="stat-value" id="prog-streak" style="color:var(--warn)">0</div>
          <div class="stat-target" data-i18n="dashboard.resetsIfMissed">нулира се при пропуск</div>
        </div>
        <div class="stat-card water">
          <div class="stat-icon">💧</div>
          <div class="stat-label" data-i18n="progress.avgWater">Средно вода</div>
          <div class="stat-value" id="prog-avg-water">0L</div>
          <div class="stat-target" data-i18n="progress.perRecordedDay">на записан ден</div>
        </div>
        <div class="stat-card sleep">
          <div class="stat-icon">😴</div>
          <div class="stat-label" data-i18n="progress.avgSleep">Среден сън</div>
          <div class="stat-value" id="prog-avg-sleep">0h</div>
          <div class="stat-target" data-i18n="progress.perRecordedDay">на записан ден</div>
        </div>
      </div>

      <div class="progress-history">
        <h3 data-i18n="progress.historyTitle">История на записите</h3>
        <table class="history-table">
          <thead>
            <tr>
              <th data-i18n="progress.tableDay">Ден</th>
              <th data-i18n="progress.tableWater">Вода</th>
              <th data-i18n="progress.tableSleep">Сън</th>
              <th data-i18n="progress.tableActivity">Активност</th>
              <th data-i18n="progress.tableDate">Дата</th>
            </tr>
          </thead>
          <tbody id="history-tbody">
            <tr><td colspan="5" style="text-align:center;color:var(--text-muted);padding:2rem">Зареждане...</td></tr>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <div id="toast-container" class="toast-container"></div>
  <script src="~/js/app.js"></script>
  <script src="~/js/navbar.js"></script>
  <script>
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProgress);
    } else {
      initProgress();
    }
  </script>
</body>
</html>