<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Register · WellTrack 100</title>
  <link rel="stylesheet" href='@Url.Content("~/css/style.css")' />
  <link rel="stylesheet" href='@Url.Content("~/css/register.css")' />
</head>

<body data-page="register">

  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <div class="auth-logo">
          <div class="logo-mark">W</div>
          <span>WellTrack <em>100</em></span>
        </div>
        <button id="lang-toggle-btn" type="button" class="lang-toggle-btn">EN / BG</button>
      </div>

      <h1 data-i18n="auth.registerTitle">Start the challenge</h1>
      <p class="subtitle" data-i18n="auth.registerDescription">Day 1 begins the moment you register.</p>

      <div id="alert" class="alert"></div>

      <form id="register-form">
        <div class="form-group">
          <label for="name" data-i18n="auth.name">Full name</label>
          <input type="text" id="name" placeholder="Alex Johnson" data-i18n="auth.name" data-i18n-placeholder="auth.namePlaceholder" required />
        </div>
        <div class="form-group">
          <label for="age" data-i18n="auth.age">Age</label>
          <input type="number" id="age" placeholder="25" data-i18n="auth.age" data-i18n-placeholder="auth.agePlaceholder" required />
        </div>
        <div class="form-group">
          <label for="email" data-i18n="auth.email">Email</label>
          <input type="email" id="email" placeholder="you@example.com" data-i18n="auth.email" data-i18n-placeholder="auth.emailPlaceholder" required />
        </div>
        <div class="form-group">
          <label for="password" data-i18n="auth.password">Password</label>
          <input type="password" id="password" placeholder="Min. 6 characters" data-i18n="auth.password" data-i18n-placeholder="auth.passwordPlaceholder" required />
        </div>
        <div class="form-group">
          <label for="confirm" data-i18n="auth.confirmPassword">Confirm password</label>
          <input type="password" id="confirm" placeholder="••••••••" data-i18n="auth.confirmPassword" data-i18n-placeholder="auth.confirmPasswordPlaceholder" required />
        </div>
        <button type="submit" class="btn-primary" data-i18n="auth.register">Start the 100-day challenge 🚀</button>
      </form>

      <div class="auth-footer">
        <span data-i18n="auth.alreadyHaveAccount">Already have an account?</span>
        <a href="@Url.Action("Login", "Home")" data-i18n="auth.login">Log in</a>
      </div>
    </div>
  </div>

  <div id="toast-container" class="toast-container"></div>
  <script src='@Url.Content("~/js/i18n.js")'></script>
  <script src='@Url.Content("~/js/app.js")'></script>
  <script src='@Url.Content("~/js/register.js")'></script>
</body>

</html>