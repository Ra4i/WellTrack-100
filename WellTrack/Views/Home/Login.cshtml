<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login · WellTrack 100</title>
  <link rel="stylesheet" href='@Url.Content("~/css/style.css")' />
  <link rel="stylesheet" href='@Url.Content("~/css/login.css")' />
</head>
<body data-page="login">

  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <div class="auth-logo">
          <div class="logo-mark">W</div>
          <span>WellTrack <em>100</em></span>
        </div>
        <button id="lang-toggle-btn" type="button" class="lang-toggle-btn">EN / BG</button>
      </div>

      <h1 data-i18n="auth.loginTitle">Welcome back</h1>
      <p class="subtitle" data-i18n="auth.loginDescription">Continue your 100-day wellness journey.</p>

      <div id="alert" class="alert"></div>

      <form id="login-form">
        <div class="form-group">
          <label for="email" data-i18n="auth.email">Email</label>
          <input type="email" id="email" placeholder="you@example.com" data-i18n="auth.email" data-i18n-placeholder="auth.emailPlaceholder" required />
        </div>
        <div class="form-group">
          <label for="password" data-i18n="auth.password">Password</label>
          <input type="password" id="password" placeholder="••••••••" data-i18n="auth.password" data-i18n-placeholder="auth.passwordPlaceholder" required />
        </div>
        <button type="submit" class="btn-primary" data-i18n="auth.login">Log in</button>
      </form>

      <div class="auth-footer">
        <span data-i18n="auth.noAccount">Don't have an account?</span>
        <a href="@Url.Action("Register", "Home")" data-i18n="nav.startChallenge">Start the challenge →</a>
      </div>
      <div class="auth-footer" style="margin-top:0.5rem">
        <a href="@Url.Action("Index", "Home")" style="color:var(--text-muted);font-size:0.82rem"><span aria-hidden="true">←</span> <span data-i18n="common.back">Back</span></a>
      </div>
    </div>
  </div>

  <div id="toast-container" class="toast-container"></div>
  <script src='@Url.Content("~/js/i18n.js")'></script>
  <script src='@Url.Content("~/js/app.js")'></script>
  <script src='@Url.Content("~/js/login.js")'></script>
</body>
</html>