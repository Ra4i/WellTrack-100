        <div class="tips-sidebar">
          <h3>💡 <span data-i18n="messages.yourMessages">Бързи съвети</span></h3>
          <div class="tips-list" id="tips-list">
            <!-- tips rendered by JS so they respect language -->
          </div>
        </div>
      </div>

      <div id="toast-container" class="toast-container"></div>
    </main>
  </div>

  <script>
    const translations = {
      en: {
        navMain: "Main",
        challenge: "100-day challenge"
      },
      bg: {
        navMain: "Основно",
        challenge: "100-дневно предизвикателство"
      }
    };

    function applyMessagesTranslations() {
      const currentLang = getCurrentLanguage() || 'bg';
      document.querySelectorAll("[data-translate]").forEach(el => {
        const key = el.getAttribute("data-translate");
        if (translations[currentLang] && translations[currentLang][key]) {
          el.textContent = translations[currentLang][key];
        }
      });
    }

    window.applyPageTranslations = applyMessagesTranslations;
  </script>
