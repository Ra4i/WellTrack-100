          <a class="logout-btn" title="Изход" href="@Url.Action("Login", "Home")">⏏</a>
        </div>
      </div>
    </aside>

    <main class="main-content">
      <div class="page-header">
        <h1 data-i18n="messages.title">Съобщения и чат</h1>
        <p class="breadcrumb">WellTrack 100 · <span class="user-display-name"></span></p>
      </div>

      <div class="messages-container">
        <!-- Chat Area -->
        <div class="chat-section">
          <div class="chat-header">
            <div style="display:flex;align-items:center;gap:0.75rem;">
              <span style="font-size:1.5rem;">🤖</span>
              <div>
                <h2 data-i18n="messages.chatbot">Wellness Chatbot</h2>
                <p style="font-size:0.85rem;color:var(--text-muted);" data-i18n="messages.chatbotSubtitle">Твоят личен уелнес треньор</p>
              </div>
            </div>
          </div>

          <div class="chat-messages" id="chat-messages">
            <div class="message bot-message">
              <div class="message-avatar">🤖</div>
              <div class="message-content">
                <p id="welcome-msg"></p>
              </div>
              <small class="message-time" id="welcome-time">Сега</small>
            </div>
          </div>

          <div class="chat-input-area">
            <textarea
