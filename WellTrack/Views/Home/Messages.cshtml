          "Нужни са 21–100 дни за изграждане на нов навик. Инвестираш в по-здравословна версия на себе си.",
          "Малките победи изграждат темпото. Един здравословен навик води до следващ. Свързвай ги заедно!",
          "Следи навиците си визуално — маркирай всеки успешен ден. Виждането на растящата верига е невероятно мотивиращо.",
          "Направи здравословните навици лесни: сложи вода на бюрото, спортните дрехи до леглото. Премахни пречките.",
          "Мозъкът ти обича шаблони. Запълни времето за цигари/алкохол с упражнения или хоби."
        ],
        social: [
          "Сподели пътя си с доверени приятели и семейство. Тяхната вяра в теб е по-важна, отколкото мислиш.",
          "Кажи на хората за целите си. Отговорността значително увеличава шансовете за успех.",
          "Когато се чувстваш самотен, потърси контакт вместо да се върнеш. Позвъни на приятел, запиши се в клас. Връзката лекува.",
          "Обкръжи се с хора, които поддържат целите ти. Заслужаваш хора, които те издигат!",
          "Намери общност за подкрепа онлайн или лично. Знаейки, че и други се борят с това, е невероятно мощно."
        ],
        offTopic: [
          "Специализирал съм се в помощ за спиране на цигари, алкохол, фитнес и благосъстояние. Как мога да те подкрепя днес?",
          "Това е извън моята специализация — фокусирам се върху спирането на цигари и алкохол и здравословните навици. С каква цел мога да помогна?",
          "Нека насочим разговора към твоето здравно пътуване. Върху какво искаш да работим днес?"
        ]
      }
    };

    // ── Tips content per language ─────────────────────────────────
    const TIPS = {
      en: [
        { icon: '💧', title: 'Drink Water',       text: 'Drinking water reduces cravings and keeps you healthy.' },
        { icon: '🏃', title: 'Exercise',           text: 'Physical activity releases endorphins — your natural mood boosters.' },
        { icon: '😴', title: 'Sleep Well',         text: 'Good sleep reduces cravings. Aim for 7–9 hours per night.' },
        { icon: '🧘', title: 'Meditate',           text: 'Practice mindfulness — even 5 minutes a day helps significantly!' },
        { icon: '👥', title: 'Seek Support',       text: 'Share your journey with friends or family.' },
        { icon: '🎯', title: 'Track Progress',     text: 'Log your daily achievements in WellTrack.' }
      ],
      bg: [
        { icon: '💧', title: 'Пий вода',          text: 'Пиенето на вода намалява желанията и те държи здрав.' },
        { icon: '🏃', title: 'Тренирай',           text: 'Физическата активност освобождава ендорфини — естествените ти стимулатори.' },
        { icon: '😴', title: 'Спи добре',          text: 'Добрият сън намалява желанията. Целта е 7–9 часа на нощ.' },
        { icon: '🧘', title: 'Медитирай',          text: 'Практикувай внимателност — дори 5 минути дневно помагат значително!' },
        { icon: '👥', title: 'Потърси подкрепа',   text: 'Сподели пътя си с приятели или семейство.' },
        { icon: '🎯', title: 'Следи прогреса',     text: 'Записвай ежедневните си постижения в WellTrack.' }
      ]
    };

    // ── Init ──────────────────────────────────────────────────────
    const messagesUser = getCurrentUser();
    if (messagesUser) {
      document.querySelectorAll('.user-display-name').forEach(el => el.textContent = messagesUser.name || 'User');
      document.querySelectorAll('.user-avatar-init').forEach(el => el.textContent = (messagesUser.name || 'U').charAt(0).toUpperCase());
    }

    // Read language ONCE — this is the key fix so chatbot always
    // uses the correct language, not a stale closure
    function getLang() {
      return (typeof getCurrentLanguage === 'function') ? getCurrentLanguage() : 'bg';
    }

    function renderUI() {
      const lang = getLang();

      // Welcome message
      const welcomeEl = document.getElementById('welcome-msg');
      const welcomeTime = document.getElementById('welcome-time');
      if (welcomeEl) {
        welcomeEl.textContent = lang === 'en'
          ? "Hello! I'm your wellness coach. I'm here to help you quit smoking and alcohol. Ask me about motivation, managing cravings, or building healthy habits! 💪"
          : "Здравей! Аз съм твоят уелнес треньор. Тук съм, за да ти помогна да се откажеш от цигарите и алкохола. Попитай ме за мотивация, управление на желанията или изграждане на здравословни навици! 💪";
      }
      if (welcomeTime) welcomeTime.textContent = lang === 'en' ? 'Now' : 'Сега';

      // Placeholder
      const messageInput = document.getElementById('message-input');
      if (messageInput) {
        messageInput.placeholder = lang === 'bg'
          ? 'Попитай ме за съвети как да спрем цигарите и алкохола...'
          : 'Ask me for tips on quitting smoking and alcohol...';
      }

      // Tips
      const tipsList = document.getElementById('tips-list');
      if (tipsList) {
        const tips = TIPS[lang] || TIPS.bg;
        tipsList.innerHTML = tips.map(tip => `
          <div class="tip-card">
            <h4>${tip.icon} ${tip.title}</h4>
            <p>${tip.text}</p>
          </div>
        `).join('');
      }
    }

    renderUI();

    // ── Chat logic ────────────────────────────────────────────────
    const messageInput = document.getElementById('message-input');
    const sendBtn      = document.getElementById('send-btn');
    const chatMessages = document.getElementById('chat-messages');

    sendBtn.addEventListener('click', sendMessage);
    messageInput.addEventListener('keydown', e => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
    });

    function sendMessage() {
      const content = messageInput.value.trim();
      if (!content) return;
      addMessage(content, 'user');
      messageInput.value = '';
      // Show typing indicator briefly
      const typingId = showTyping();
      setTimeout(() => {
        removeTyping(typingId);
        const response = getResponse(content.toLowerCase());
        addMessage(response, 'bot');
      }, 500 + Math.random() * 400);
    }

    function showTyping() {
      const id  = 'typing-' + Date.now();
      const div = document.createElement('div');
      div.className = 'message bot-message';
      div.id = id;
      div.innerHTML = `
        <div class="message-avatar">🤖</div>
        <div class="message-content">
          <div class="loading-dots"><span></span><span></span><span></span></div>
        </div>`;
      chatMessages.appendChild(div);
      chatMessages.scrollTop = chatMessages.scrollHeight;
      return id;
    }

    function removeTyping(id) {
      const el = document.getElementById(id);
      if (el) el.remove();
    }

    function addMessage(text, type) {
      const div     = document.createElement('div');
      div.className = `message ${type}-message`;

      const avatar     = document.createElement('div');
      avatar.className = 'message-avatar';
      avatar.textContent = type === 'user' ? '👤' : '🤖';

      const content     = document.createElement('div');
      content.className = 'message-content';
      content.innerHTML = `<p>${escapeHtmlLocal(text)}</p>`;

      const time     = document.createElement('small');
      time.className = 'message-time';
      time.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

      div.appendChild(avatar);
      div.appendChild(content);
      div.appendChild(time);
      chatMessages.appendChild(div);
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function detectTopic(input) {
      const lang     = getLang();
      const keywords = TOPIC_KEYWORDS[lang] || TOPIC_KEYWORDS.en;
      const scores   = {};

      for (const [topic, kwList] of Object.entries(keywords)) {
        scores[topic] = kwList.filter(kw => input.includes(kw.toLowerCase())).length;
      }

      const maxScore = Math.max(...Object.values(scores));
      if (maxScore === 0) return 'offTopic';
      return Object.keys(scores).find(topic => scores[topic] === maxScore) || 'offTopic';
    }

    function getResponse(input) {
      const lang      = getLang();
      const responses = CHATBOT_RESPONSES[lang] || CHATBOT_RESPONSES.bg;
      const topic     = detectTopic(input);
      const pool      = responses[topic] || responses.offTopic;
      return pool[Math.floor(Math.random() * pool.length)];
    }

    function escapeHtmlLocal(text) {
      const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
      return text.replace(/[&<>"']/g, m => map[m]);
    }

    applyTranslations();
  </script>
</body>
</html>