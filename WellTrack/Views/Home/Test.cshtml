<!DOCTYPE html>
<html lang="bg">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>QR Генератор · WellTrack 100</title>
  <script>
    try { var s=JSON.parse(localStorage.getItem('wt_user_settings')||'{}'); if(s.theme==='light') document.documentElement.setAttribute('data-theme','light'); } catch(e){}
  </script>
  <link rel="stylesheet" href="~/css/style.css" />
  <link rel="stylesheet" href="~/css/navbar.css" /> 
  <script src="~/js/i18n.js"></script>
</head>
<body>

  <div class="app-layout">

    <!-- ── Sidebar ── -->
    <aside class="sidebar">
      <div class="sidebar-logo">
        <div class="logo-mark">W</div>
        <div class="logo-text">WellTrack <small>100-дневно предизвикателство</small></div>
      </div>
      <span class="nav-section-label">Основно</span>
      <a class="nav-item" href="@Url.Action("Dashboard", "Home")"><span class="nav-icon">⚡</span> <span data-i18n="nav.dashboard">Табло</span></a>
      <a class="nav-item" href="@Url.Action("Levels", "Home")"><span class="nav-icon">🏆</span> <span data-i18n="nav.levels">Нива</span></a>
      <a class="nav-item" href="@Url.Action("Progress", "Home")"><span class="nav-icon">📈</span> <span data-i18n="nav.progress">Прогрес</span></a>
      <a class="nav-item" href="@Url.Action("Journal", "Home")"><span class="nav-icon">📓</span> <span data-i18n="nav.journal">Журнал</span></a>
      <a class="nav-item" href="@Url.Action("Friends", "Home")"><span class="nav-icon">👥</span> <span data-i18n="nav.friends">Приятели</span></a>
      <a class="nav-item" href="@Url.Action("Messages", "Home")"><span class="nav-icon">💬</span> <span data-i18n="nav.messages">Съобщения</span></a>
      <a class="nav-item" href="@Url.Action("Settings", "Home")"><span class="nav-icon">⚙️</span> <span data-i18n="nav.settings">Настройки</span></a>
      <div class="sidebar-bottom">
        <div class="user-chip">
          <div class="user-avatar user-avatar-init">A</div>
          <span class="user-name user-display-name">Зареждане...</span>
          <a class="logout-btn" title="Изход" href="@Url.Action("Login", "Home")">⏏</a>
        </div>
      </div>
    </aside>

    <!-- ── Main ── -->
    <main class="main-content">
      <div class="page-header">
        <h1>QR Генератор</h1>
        <p class="breadcrumb">WellTrack 100 · <span class="user-display-name"></span></p>
      </div>

      <div style="max-width:480px;">
        <div class="log-section">
          <h3 style="margin-top:0">Генериране на QR код</h3>

          <button type="button" class="btn-primary" id="btn" style="margin: top 25px;">Генерирай</button>

          <div id="status" style="margin-top:1rem;font-size:0.9rem;color:var(--text-muted);"></div>

          <div id="qr-result" style="display:none;margin-top:1.5rem;text-align:center;">
            <img id="qrImage" width="200" height="200"
                 style="border-radius:12px;border:1px solid var(--border);background:white;padding:8px;" />
          </div>
        </div>
      </div>
    </main>
  </div>

  <div id="toast-container" class="toast-container"></div>

  <script src="~/js/app.js"></script>
  <script src="~/js/sidebar.js"></script>
  <script>
    const user = getCurrentUser();

  document.querySelectorAll('.user-display-name').forEach(el => el.textContent = user.name);
  document.querySelectorAll('.user-avatar-init').forEach(el => el.textContent = user.name.charAt(0).toUpperCase());

    document.getElementById('btn').onclick = async () => {
      const status  = document.getElementById('status');
      const img     = document.getElementById('qrImage');
      const result  = document.getElementById('qr-result');
      const baseUrl = 'http://localhost:5001';

      const lang = (typeof getCurrentLanguage === 'function') ? getCurrentLanguage() : 'bg';
      status.innerText = lang === 'en' ? 'Generating...' : 'Генериране...';
      result.style.display = 'none';

      try {
        const response = await fetch(`${baseUrl}/api/users/generate-age-qr/${user.id}/${user.age}`, {
          method: 'POST'
        });

        if (response.ok) {
          const data   = await response.json();
          const finalUrl = baseUrl + data.url + '?t=' + new Date().getTime();
          img.src = finalUrl;
          result.style.display = 'block';
          status.innerText = lang === 'en' ? 'QR code is ready!' : 'QR кодът е готов!';
          if (typeof showToast === 'function') showToast(status.innerText);
        } else {
          status.innerText = lang === 'en' ? 'API communication error.' : 'Грешка при комуникация с API.';
        }
      } catch (error) {
        console.error(error);
        status.innerText = lang === 'en' ? 'Cannot connect to backend.' : 'Няма връзка с бекенда.';
      }
    };
  </script>
</body>
</html>